# Safehouse configuration — copy to `.env` and edit. Every value here has a
# working default except the two secrets the compose stack refuses to start
# without. The app boots and plays a full session with NONE of the optional
# ones set: no AI, no internet, no Docker (DESIGN.md Principle 5 / NG7).
#
#   cp .env.example .env
#   docker compose -f infra/docker-compose.yml --env-file .env up -d

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API + WS + SPA are served on. Also the host port compose publishes.
PORT=8787

# File store and the embedded database live here (gitignored).
# Local dev: ./data  ·  in the container: /data (a named volume).
DATA_DIR=./data

# Signs cookies. Any long random string; changing it logs every device out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED by the compose stack.
SESSION_SECRET=

# pino level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Origin the join QR encodes. Leave BLANK in production: the server also serves
# the built SPA, so its own LAN address is correct and the QR points at the SPA
# route `/join/<code>` (the token comes from `/api/join/<code>` — a scanning
# phone must land on the join screen, never on raw JSON).
#
# Set it only when Vite is serving the SPA on a different port during dev, so a
# phone on the venue Wi-Fi scans something it can actually reach:
#   WEB_ORIGIN=http://192.168.1.20:5173
WEB_ORIGIN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# UNSET for local dev — the app then runs embedded PGlite at DATA_DIR/pglite,
# which is real Postgres in-process and needs no Docker. Set it to use a
# server: compose builds this value for the `app` container automatically, so
# leave it blank here unless you are pointing at your own Postgres.
# DATABASE_URL=postgres://safehouse:changeme@localhost:5432/safehouse

# Credentials for the compose `postgres:16` service and the backup sidecar.
POSTGRES_USER=safehouse
POSTGRES_DB=safehouse
# REQUIRED by the compose stack.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Backups (compose `backup` service — nightly dump + file-store sync, §15)
# ---------------------------------------------------------------------------

# Where dumps land. Point this at an external drive or a synced folder so the
# backup actually leaves the laptop; a backup that never left is not a backup.
BACKUP_DIR=./backups
# Local time of the nightly run, and how many days of dumps to keep.
BACKUP_AT=04:30
BACKUP_RETAIN_DAYS=30

# ---------------------------------------------------------------------------
# The Fixer — optional, local models only (DESIGN.md §12, D12)
# ---------------------------------------------------------------------------

# Leave BLANK to switch the whole AI copilot off cleanly: the manual path for
# every feature stays, and the Fixer routes answer "switched off" (NG7).
#
# Normal setup — the dedicated inference box on the LAN:
#   LLM_BASE_URL=http://inference-box.lan:8080/v1
# Away-game fallback — `docker compose --profile llm up -d` on the laptop:
#   LLM_BASE_URL=http://llm:8080/v1
LLM_BASE_URL=

# Two slots (FR12.16): `primary` writes and reasons, `fast` does the mechanical
# session-time work. Names as the inference server advertises them.
LLM_MODEL_PRIMARY=
LLM_MODEL_FAST=

# `llm` profile only: the .gguf inside the gitignored ./models folder, the
# alias it is served under, and the context window.
LLM_MODEL_FILE=primary.gguf
LLM_PORT=8080
LLM_CTX_SIZE=8192
# LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# ---------------------------------------------------------------------------
# Integrations — optional
# ---------------------------------------------------------------------------

# Mirrors PUBLIC rolls and published recaps to a Discord channel (FR2.10).
# Unset means nothing ever leaves the machine.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

# Tag compose runs / buildx pushes. Built multi-arch (amd64 + arm64, §16).
APP_IMAGE=safehouse/app:latest

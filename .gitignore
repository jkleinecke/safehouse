# Never commit the rulebooks or models (owned content / large binaries)
*.pdf
models/

# Dependencies & build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Runtime data
data/
uploads/
*.log

# Playwright (apps/web/e2e) — traces, screenshots, HTML report
test-results/
playwright-report/
blob-report/
.playwright/

# Backups written by the compose `backup` sidecar (default BACKUP_DIR)
backups/

# Env & local config
.env
.env.*
!.env.example

# Editor/OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Cygwin crash dumps (a wedged grep leaves these behind)
*.stackdump

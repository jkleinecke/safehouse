# Safehouse configuration — THE one env file, `.env` at the repo root. Both the
# shell start (`pnpm dev:server`) and the compose stack read it; compose does so
# by itself because compose.yaml sits beside it, so there is no --env-file and
# there is no infra/.env. Every value here has a working default except the two
# secrets the compose stack refuses to start without, and `pnpm docker:up`
# generates those on first run. The app boots and plays a full session with
# NONE of the optional ones set: no AI, no internet, no Docker (DESIGN.md
# Principle 5 / NG7).
#
#   pnpm docker:up        # creates .env from this file if it is missing
#
# Values here are STARTING POINTS. Anything a GM can change in the app — which
# AI, above all — is saved in the database and wins over this file from then on.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API + WS + SPA are served on. Also the host port compose publishes.
PORT=8787

# File store and the embedded database live here (gitignored).
# Local dev: ./data  ·  in the container: /data (a named volume).
DATA_DIR=./data

# Signs cookies. Any long random string; changing it logs every device out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED by the compose stack — `pnpm docker:up` fills it in when blank.
SESSION_SECRET=

# pino level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Origin the join QR encodes. Leave BLANK in production: the server also serves
# the built SPA, so its own LAN address is correct and the QR points at the SPA
# route `/join/<code>` (the token comes from `/api/join/<code>` — a scanning
# phone must land on the join screen, never on raw JSON).
#
# Set it only when Vite is serving the SPA on a different port during dev, so a
# phone on the venue Wi-Fi scans something it can actually reach:
#   WEB_ORIGIN=http://192.168.1.20:5173
WEB_ORIGIN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# UNSET for local dev — the app then runs embedded PGlite at DATA_DIR/pglite,
# which is real Postgres in-process and needs no Docker. Set it to use a
# server: compose builds this value for the `app` container automatically, so
# leave it blank here unless you are pointing at your own Postgres.
# DATABASE_URL=postgres://safehouse:changeme@localhost:5432/safehouse

# Credentials for the compose `postgres:16` service and the backup sidecar.
POSTGRES_USER=safehouse
POSTGRES_DB=safehouse
# REQUIRED by the compose stack — `pnpm docker:up` fills it in when blank.
POSTGRES_PASSWORD=

# Host port the database is published on — bound to 127.0.0.1, so the venue
# Wi-Fi never reaches it. It exists for the one-shots that run from the repo
# rather than inside the production image: `pnpm seed:books` (FR11.7) and
# `scripts/migrate-to-postgres.ts`. Change it if something already owns 5432.
POSTGRES_PORT=5432

# MOVING AN EXISTING CAMPAIGN IN. A campaign that started on the laptop lives
# in embedded PGlite at DATA_DIR/pglite. Do not hand-roll the move: `ws_events.id`
# is the replay cursor clients hold, so the ids must survive, and a copy that
# keeps the ids without moving the sequences past them makes every later insert
# collide (the log freezes; see docs/BUILD_REPORT.md LIVE-4). The script does
# both and verifies afterwards:
#   pnpm --filter @safehouse/server exec tsx scripts/migrate-to-postgres.ts --dry-run
#   pnpm --filter @safehouse/server exec tsx scripts/migrate-to-postgres.ts \
#     --database-url postgres://safehouse:PASSWORD@127.0.0.1:5432/safehouse
# It moves the database only — copy DATA_DIR/files into the app's volume too.

# ---------------------------------------------------------------------------
# Backups (compose `backup` service — nightly dump + file-store sync, §15)
# ---------------------------------------------------------------------------

# Where dumps land. Point this at an external drive or a synced folder so the
# backup actually leaves the laptop; a backup that never left is not a backup.
BACKUP_DIR=./backups
# Local time of the nightly run, and how many days of dumps to keep.
BACKUP_AT=04:30
BACKUP_RETAIN_DAYS=30

# ---------------------------------------------------------------------------
# The Fixer — optional (DESIGN.md §12, D12)
# ---------------------------------------------------------------------------

# WHICH AI IS CHOSEN IN THE APP, NOT HERE: GM console ▸ Fixer ▸ Which AI (the
# console's setup checklist has a row for it). Local box, Anthropic, OpenAI or
# xAI; saved per campaign; takes effect on the next message; keys stay on the
# server. Once anything has been chosen there — an explicit Off included —
# these lines are ignored, and the panel says so.
#
# So these only decide what a campaign starts with. Leave BLANK to start with
# the AI off: the manual path for every feature stays, and the Fixer routes
# answer "switched off" (NG7).
#
# Normal setup — the dedicated inference box on the LAN:
#   LLM_BASE_URL=http://inference-box.lan:8080/v1
# A server on the laptop itself, reached from inside the container:
#   LLM_BASE_URL=http://host.docker.internal:8080/v1
# Away-game fallback — `pnpm docker:up --profile llm`:
#   LLM_BASE_URL=http://llm:8080/v1
LLM_BASE_URL=

# Two slots (FR12.16): `primary` writes and reasons, `fast` does the mechanical
# session-time work. Names as the inference server advertises them.
LLM_MODEL_PRIMARY=
LLM_MODEL_FAST=

# Map vision (FR12.11) is capability-flagged: the server asks the box once
# whether its model reads images and hides the feature when it does not.
# Leave BLANK to let it decide. Set `off` to keep map vision hidden on a box
# that would accept an image part and quietly ignore it; set `on` to force it
# for a server that reads images but does not advertise the fact.
#   LLM_VISION=off
LLM_VISION=

# `llm` profile only: the .gguf inside the gitignored ./models folder, the
# alias it is served under, and the context window.
LLM_MODEL_FILE=primary.gguf
LLM_PORT=8080
LLM_CTX_SIZE=8192
# LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# ---------------------------------------------------------------------------
# Integrations — optional
# ---------------------------------------------------------------------------

# Mirrors PUBLIC rolls and published recaps to a Discord channel (FR2.10).
# Unset means nothing ever leaves the machine.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

# Tag compose runs / buildx pushes. Built multi-arch (amd64 + arm64, §16).
APP_IMAGE=safehouse/app:latest

# Where your rulebook PDFs live on the HOST, for `pnpm docker:seed`.
# Bind-mounted READ-ONLY; the books are never copied into an image (DESIGN
# §14). A relative path is taken from the repo root (where compose.yaml
# lives), so ./books is the checkout's books/ folder; an absolute path
# (D:/books, /srv/books) works too.
BOOKS_DIR=./books
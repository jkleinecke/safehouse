# Never commit the rulebooks or models (owned content / large binaries)
*.pdf
models/

# Dependencies & build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Runtime data
data/
uploads/
*.log

# Playwright (apps/web/e2e) — traces, screenshots, HTML report
test-results/
playwright-report/
blob-report/
.playwright/

# Backups written by the compose `backup` sidecar (default BACKUP_DIR)
backups/

# Env & local config
.env
.env.*
!.env.example

# Editor/OS noise
.DS_Store
Thumbs.db
# Editor state stays personal; the shared launch/task/extension files are kept
# so F5 runs the site on any checkout (Windows, macOS, Linux).
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/

# Cygwin crash dumps (a wedged grep leaves these behind)
*.stackdump

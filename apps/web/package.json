{
  "name": "@safehouse/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vendor-pdfjs.mjs && vite build",
    "postinstall": "node scripts/vendor-pdfjs.mjs",
    "vendor:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "node e2e/run.mjs",
    "e2e:strict": "node e2e/run.mjs --require",
    "e2e:install": "playwright install chromium",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safehouse/contracts": "workspace:*",
    "@safehouse/rules": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "@tanstack/react-query": "5.102.6",
    "zustand": "^5.0.15",
    "pixi.js": "^8.20.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode.react": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^7.3.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
